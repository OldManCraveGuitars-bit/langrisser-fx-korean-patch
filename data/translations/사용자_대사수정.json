    "movie001/cue/006": {
      "start": 42.7,
      "end": 48.5,
      "ko": [
        "만일 짐이 알하자드를 손에 넣지 못한다면,",
        "대륙 통일 따위 애초부터 이룰 수 없는 것."
      ],
      "list_order": 7
    },
    "movie001/cue/007": {
      "start": 49.6,
      "end": 55.2,
      "ko": [
        "이 베른하르트, 그대의 주군이 될",
        "자격조차 없다!"
      ],
      "list_order": 8
    },
    "movie001/cue/008": {
      "start": 58.9,
      "end": 65.4,
      "ko": [
        "베른하르트라 했던가. 네놈이라면",
        "이 저주스러운 빛의 봉인을 풀 수 있겠지."
      ],
      "list_order": 9
    },
    "movie001/cue/009": {
      "start": 67.9,
      "end": 69.5,
      "ko": [
        "하지만 그 전에 한 가지 묻겠다."
      ],
      "list_order": 11
    },
    "movie001/cue/010": {
      "start": 70.4,
      "end": 74.9,
      "ko": [
        "나를 해방하면 지상에 다시",
        "큰 재앙이 일어날 것이다."
      ],
      "list_order": 12
    },
    "movie001/cue/011": {
      "start": 75.0,
      "end": 76.8,
      "ko": [
